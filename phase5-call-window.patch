@@ -0,0 +1,57 @@
+// Android side effects for the ongoing-call notification. Pure rules live in ongoingCallPolicy.ts.
+import * as Notifications from "expo-notifications";
+import { Platform } from "react-native";
+import {
+  ONGOING_CALL_CATEGORY,
+  ONGOING_CALL_CHANNEL_ID,
+  ONGOING_CALL_NOTIFICATION_ID,
+  ongoingCallText,
+} from "./ongoingCallPolicy";
+
+/**
+ * Shows (or refreshes) the persistent "Tap to return to call" notification. Silent, cannot be swiped away
+ * while the call lasts. Best effort: with notifications turned off in system settings nothing is shown and
+ * nothing else changes. Never throws.
+ */
+export async function showOngoingCallNotification(input: {
+  callId: string;
+  matchId: string;
+  partnerName?: string | null;
+}): Promise<void> {
+  if (Platform.OS !== "android") return;
+  try {
+    await Notifications.setNotificationChannelAsync(ONGOING_CALL_CHANNEL_ID, {
+      name: "Ongoing call",
+      description: "Shows while you are on a video call so you can jump back to it.",
+      importance: Notifications.AndroidImportance.LOW,
+      sound: null,
+      enableVibrate: false,
+      showBadge: false,
+      lockscreenVisibility: Notifications.AndroidNotificationVisibility.PRIVATE,
+    });
+    const text = ongoingCallText(input.partnerName);
+    await Notifications.scheduleNotificationAsync({
+      identifier: ONGOING_CALL_NOTIFICATION_ID,
+      content: {
+        title: text.title,
+        body: text.body,
+        sticky: true,
+        autoDismiss: false,
+        data: { category: ONGOING_CALL_CATEGORY, callId: input.callId, matchId: input.matchId },
+      },
+      trigger: { channelId: ONGOING_CALL_CHANNEL_ID },
+    });
+  } catch {
+    // Notification permission denied or module unavailable: the call itself is unaffected.
+  }
+}
+
+/** Removes the ongoing-call notification (call ended, screen closed, or a stale one after the app restarted). */
+export async function dismissOngoingCallNotification(): Promise<void> {
+  if (Platform.OS !== "android") return;
+  try {
+    await Notifications.dismissNotificationAsync(ONGOING_CALL_NOTIFICATION_ID);
+  } catch {
+    // Already gone.
+  }
+}
diff --git a/mobile/src/services/ongoingCallPolicy.ts b/mobile/src/services/ongoingCallPolicy.ts
new file mode 100644
index 0000000..f0a4abd
--- /dev/null
+++ b/mobile/src/services/ongoingCallPolicy.ts
@@ -0,0 +1,36 @@
+// Pure rules for the "ongoing call" notification (no React Native imports, unit tested). While a video call is
+// connected, a quiet persistent notification says "Tap to return to call", like WhatsApp.
+import { isValidUUID } from "../utils/validation";
+
+export const ONGOING_CALL_CHANNEL_ID = "ongoing_call";
+export const ONGOING_CALL_CATEGORY = "ongoing_call";
+export const ONGOING_CALL_NOTIFICATION_ID = "chahat-ongoing-call";
+
+export interface OngoingCallData {
+  callId: string;
+  matchId: string;
+}
+
+/** Validates the data of a tapped ongoing-call notification. Nothing here is trusted: the server is asked next. */
+export function parseOngoingCallData(data: unknown): OngoingCallData | null {
+  if (!data || typeof data !== "object") return null;
+  const { category, callId, matchId } = data as Record<string, unknown>;
+  if (category !== ONGOING_CALL_CATEGORY) return null;
+  if (typeof callId !== "string" || !isValidUUID(callId)) return null;
+  if (typeof matchId !== "string" || !isValidUUID(matchId)) return null;
+  return { callId: callId.toLowerCase(), matchId: matchId.toLowerCase() };
+}
+
+/** True when the app is already showing the call screen, so a tap must not open a second copy of it. */
+export function isOnCallScreen(pathname: string | null | undefined): boolean {
+  return typeof pathname === "string" && pathname.startsWith("/call/");
+}
+
+/** Notification text. The partner's name stays off a locked screen's public version. */
+export function ongoingCallText(partnerName: string | null | undefined): { title: string; body: string } {
+  const name = (partnerName ?? "").trim();
+  return {
+    title: name ? `Video call with ${name}` : "Video call",
+    body: "Ongoing call · Tap to return to call",
+  };
+}
diff --git a/mobile/src/services/pictureInPicture.ts b/mobile/src/services/pictureInPicture.ts
new file mode 100644
index 0000000..3bacfad
--- /dev/null
+++ b/mobile/src/services/pictureInPicture.ts
@@ -0,0 +1,88 @@
+// Floating video-call window (Android picture-in-picture), like WhatsApp: press back or home during a connected
+// video call and the call shrinks into a small movable window over whatever you open next; tap it to go back.
+// Backed by the local native module in mobile/modules/call-state. Best effort: if the module is missing
+// (tests, Expo Go, iOS, old builds) everything here reports "not supported" and the call screen keeps its
+// normal back-button dialog.
+import { Platform } from "react-native";
+
+interface PipModule {
+  isPictureInPictureSupported?(): boolean;
+  isInPictureInPictureMode?(): boolean;
+  setPictureInPictureArmed?(armed: boolean): Promise<void>;
+  enterPictureInPicture?(): Promise<boolean>;
+}
+
+let nativeModule: PipModule | null | undefined;
+
+function loadModule(): PipModule | null {
+  if (nativeModule !== undefined) return nativeModule;
+  try {
+    // eslint-disable-next-line @typescript-eslint/no-var-requires
+    const expo = require("expo");
+    nativeModule = (expo.requireOptionalNativeModule?.("ChahatCallState") as PipModule | null | undefined) ?? null;
+  } catch {
+    nativeModule = null;
+  }
+  return nativeModule ?? null;
+}
+
+/** For tests. */
+export function __setPictureInPictureModuleForTests(mod: PipModule | null | undefined): void {
+  nativeModule = mod;
+}
+
+/** Only a connected video call is shrunk into the window; ringing and connecting keep the confirm dialog. */
+export function shouldMinimizeOnBack(input: {
+  status: string;
+  mediaPhase: string;
+  callKind: string | null;
+  supported: boolean;
+}): boolean {
+  return (
+    input.supported &&
+    input.callKind === "video" &&
+    input.status === "accepted" &&
+    input.mediaPhase === "connected"
+  );
+}
+
+/** Width below which the window is treated as the floating box (a phone screen is far wider than this). */
+export const PIP_MAX_WIDTH_DP = 260;
+
+export function isPictureInPictureSupported(): boolean {
+  if (Platform.OS !== "android") return false;
+  try {
+    return loadModule()?.isPictureInPictureSupported?.() === true;
+  } catch {
+    return false;
+  }
+}
+
+export function isInPictureInPicture(): boolean {
+  if (Platform.OS !== "android") return false;
+  try {
+    return loadModule()?.isInPictureInPictureMode?.() === true;
+  } catch {
+    return false;
+  }
+}
+
+/** Arms (or disarms) the automatic window when the user leaves the app during a call. Never throws. */
+export async function setPictureInPictureArmed(armed: boolean): Promise<void> {
+  if (Platform.OS !== "android") return;
+  try {
+    await loadModule()?.setPictureInPictureArmed?.(armed);
+  } catch {
+    // Best effort.
+  }
+}
+
+/** Shrinks the app into the floating window. Resolves false when Android refuses or it is unavailable. */
+export async function enterPictureInPicture(): Promise<boolean> {
+  if (Platform.OS !== "android") return false;
+  try {
+    return (await loadModule()?.enterPictureInPicture?.()) === true;
+  } catch {
+    return false;
+  }
+}
